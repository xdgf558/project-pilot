# ── macOS ──────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ── Xcode ──────────────────────────────────────────────────────────────
## Build 产物
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## 用户级工程状态(每个人不一样,不该进仓库)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

## Xcode 工程内嵌的 SPM 状态
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcworkspace/xcshareddata/swiftpm/

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# ── Swift Package Manager ──────────────────────────────────────────────
.build/
.swiftpm/
# 这里刻意不写 Packages/ —— 那是 Swift 3 时代 SPM 的检出目录,现代 SPM
# 不再使用(检出在 .build/ 里)。若将来把本地子 package 放进 Packages/,
# 忽略它会静默漏提交源码。宁可多一次 git status 噪音。
#
# Package.resolved 必须提交 —— v0.2 §11 规则 8:不使用 latest 浮动版本,
# 依赖版本要能精确复现和回滚。

# ── 依赖管理(如果将来用到)────────────────────────────────────────────
Pods/
Carthage/Build/
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# ── 签名与凭据:绝对不能进公开仓库 ─────────────────────────────────────
*.p12
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
.env
.env.*
!.env.example
secrets.json
*credentials*.json
*.pem
*.key

# ── ProjectPilot 运行时产物 ────────────────────────────────────────────
# 作业目录(spec.json / heartbeat / exit.json / result.json)
jobs/
runs/
# 本地任务数据与配置
pm-data/
tasks.json
*.local.json
# 契约测试的 --live 录制输出
fixtures/live/

# ── CI 产物(本地跑同样的命令时也会生成)────────────────────────────────
test-results*.xml

# ── 日志与临时文件 ─────────────────────────────────────────────────────
*.log
*.tmp
tmp/
.claude/settings.local.json
